SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Mot de passe d'accès à l'appli (sans lui, personne ne peut entrer, sauf avec DEBUG_MODE)
APP_PASSWORD=
# Mettre à "true" en local pour afficher le panneau de debug (ne jamais activer en prod)
DEBUG_MODE=
# Secret des crons Vercel : base Supabase gardée active (/api/keepalive), petit mot du jour (/api/notifications/envoi)
CRON_SECRET=
# Clés VAPID du petit mot quotidien (pnpm dlx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact demandé par les services push, au format mailto:adresse
VAPID_SUJET=
# Blague : "true" met le dragon en grève (pancarte, plus de boutons, temps figé). Redéployer après changement.
GREVE=
