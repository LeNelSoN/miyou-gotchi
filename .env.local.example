SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Mot de passe d'accès à l'appli (sans lui, personne ne peut entrer, sauf avec DEBUG_MODE)
APP_PASSWORD=
# Mettre à "true" en local pour afficher le panneau de debug (ne jamais activer en prod)
DEBUG_MODE=
# Secret du cron Vercel qui garde la base Supabase active (/api/keepalive)
CRON_SECRET=
# Secret partagé avec le homelab qui génère les rêves (/api/ia/*)
IA_SECRET=
